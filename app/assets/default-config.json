{
  "version": 1,
  "chain": "PROXY-BYPASS",
  "chain6": "PROXY-BYPASS6",
  "redsocks_conf": "/etc/redsocks.conf",
  "redsocks_port": 12345,
  "ports": [443],
  "timeout_s": 6.0,
  "interval_min": 15,
  "learn_every": 4,
  "probe_path": "/",
  "workers": 8,
  "watch": [
    "openrouter.ai",
    "api.openai.com",
    "chatgpt.com",
    "api.anthropic.com",
    "generativelanguage.googleapis.com",
    "aiplatform.googleapis.com",
    "huggingface.co",
    "api.github.com",
    "raw.githubusercontent.com",
    "codeload.github.com",
    "registry.npmjs.org",
    "pypi.org",
    "files.pythonhosted.org",
    "registry-1.docker.io",
    "auth.docker.io",
    "discord.com",
    "api.notion.com",
    "api.slack.com",
    "www.figma.com",
    "api.groq.com",
    "api.mistral.ai",
    "api.replicate.com",
    "www.googleapis.com",
    "graph.microsoft.com",
    "www.cloudflare.com",
    "api.deepseek.com"
  ],
  "ignore": [
    "localhost",
    "localdomain",
    "telegram.org",
    "api.telegram.org",
    "t.me",
    "telegram.me",
    "vk.com",
    "yandex.ru",
    "ya.ru",
    "mail.ru",
    "sber.ru",
    "gosuslugi.ru"
  ],
  "doh": {
    "enabled": true,
    "host": "cloudflare-dns.com",
    "path": "/dns-query"
  },
  "learn": {
    "enabled": true,
    "globs": [
      "/home/*/.hermes/logs/*.log",
      "/var/log/redsocks.log"
    ],
    "max_lines": 4000,
    "max_new": 8
  }
}
